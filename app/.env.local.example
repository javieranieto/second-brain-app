# Lo llena Claude en la instalacion (o tu, a mano). Se copia a .env.local.
# Supabase: Project Settings -> API Keys.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_XXXXXXXX
VITE_NOMBRE=Tu nombre

# Ojo: todo lo que empieza con VITE_ queda escrito dentro de la app y es publico.
# Aqui va SOLO la clave publicable. La service_role nunca.
# Lo que protege tus notas son los permisos (RLS) de la base, no esta clave.
